# Stripe Secret Key (Get this from https://dashboard.stripe.com/apikeys)
STRIPE_API_KEY=sk_test_your_stripe_secret_key_here

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=stickershopdb
DATABASE_USERNAME=root
DATABASE_PASSWORD=your_database_password_here

# Spring Security Credentials
STICKERSHOP_USERNAME=your_username
STICKERSHOP_PASSWORD=your_password
STICKERSHOP_ROLES=ADMIN,USER

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_NAME=/path/to/your/log/app.log

# JPA Configuration
JPA_SHOW_URL=true
HIBERNATE_FORMAT_SQL=true
